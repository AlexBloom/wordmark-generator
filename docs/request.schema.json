{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wordmark Generator request",
  "type": "object",
  "properties": {
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 8,
      "description": "Brand names. Alternate between names unless combine is true."
    },
    "count": {
      "type": "integer",
      "enum": [
        10,
        50,
        100,
        250
      ],
      "default": 50
    },
    "combine": {
      "type": "boolean",
      "default": false,
      "description": "Stack all supplied names in every lockup."
    },
    "fontDirectory": {
      "type": "string",
      "description": "Local font directory; omitted uses installed fonts."
    },
    "fontFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed": {
      "type": "integer",
      "default": 9000
    },
    "excludeFamilies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional font IDs from list_fonts."
    }
  },
  "required": [
    "names"
  ],
  "additionalProperties": false
}
